# Copy to .env for the local stack (compose.yaml). All of it is optional.

# hack/build-editor.sh tags specdoc-editor:local; override to test another tag.
#EDITOR_IMAGE=specdoc-editor:1.11.0

# Target repos the board is allowed to touch, comma separated. Without these
# the board renders specs but resolves no approvers and opens no PRs.
#NAMESPACES=you/your-specs
#DEFAULT_NAMESPACE=you/your-specs

# Read-only PAT is enough to resolve .specs/roles.yml and scan commits.
# Opening PRs needs write. Never commit a real token.
#GITHUB_TOKEN=

# Hosted deployments use a separate migration job and restricted runtime role.
# See docs/security.md; these settings are not needed for the loopback dev stack.
#BOARD_ADMIN_IDS=12345
#BOARD_MODERATOR_IDS=67890
#MODEL_ALLOWED_ORIGINS=https://model.example
#SPECDOC_SECRET_KEY=
#MODEL_AUTOMATION_DISABLED=true
#MONITORING_TOKEN=
